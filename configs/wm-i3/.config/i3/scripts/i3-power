##!/bin/bash
# Requires: dmenu, x11(will not work properly on Wayland)

choice=$(printf "Shutdown\nReboot\nSuspend\nLock\nLogout\n" | dmenu -fn 'JetBrainsMono Nerd Font 10' -nb '#050907' -nf '#55E17A' -sb '#0B1410' -sf '#A0FFB2' -i )

case "$choice" in
  Shutdown) systemctl poweroff ;;
  Reboot) systemctl reboot ;;
  Suspend) systemctl suspend ;;
  Lock) i3lock ;;
  Logout) i3-msg exit ;;
  *) exit 0 ;;
esac
