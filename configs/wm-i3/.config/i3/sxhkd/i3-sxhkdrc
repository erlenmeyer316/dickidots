# === LAUNCH ===

# Launch Rofi Application Menu
alt + space
	rofi -show drun -modi drun -line-padding 4 -hide-scrollbar -show-icons -theme ~/.config/i3/rofi/config.rasi

# Launch Terminal 
alt + Return
	st

# === WINDOW STATE ===

# Toggle Floating
alt + shift + f
	i3-msg floating toggle

# Toggle Fullscreen
alt + f
	i3-msg fullscreen toggle

# === WINDOW NAVIGATION ===

# Focus Left
alt + h
	i3-msg focus left

# Focus Down
alt + j
	i3-msg focus down

# Focus Up
alt + k
	i3-msg focus up

# Focus Right
alt + l
	i3-msg focus right

# Move Window Left
ctrl + alt + h
	i3-msg move left

# Move Window Down
ctrl + alt + j
	i3-msg move down

# Move Window Up
ctrl + alt + k
	i3-msg move up

# Move Window Right
ctrl + alt + l
	i3-msg move right

# Focus Left (Arrow)
alt + Left
	i3-msg focus left

# Focus Down (Arrow)
alt + Down
	i3-msg focus down

# Focus Up (Arrow)
alt + Up
	i3-msg focus up

# Focus Right (Arrow)
alt + Right
	i3-msg focus right

# Move Window Left (Arrow)
ctrl + alt + Left
	i3-msg move left

# Move Window Down (Arrow)
ctrl + alt + Down
	i3-msg move down

# Move Window Up (Arrow)
ctrl + alt + Up
	i3-msg move up

# Move Window Right (Arrow)
ctrl + alt + Right
	i3-msg move right

# === WINDOW RESIZE ===

# Resize Grow Width
ctrl + shift + h
	i3-msg resize grow width 3 px or 3 ppt

# Resize Shrink Height
ctrl + shift + j
	i3-msg resize shrink height 3 px or 3 ppt

# Resize Grow Height
ctrl + shift + k
	i3-msg resize grow height 3 px or 3 ppt

# Resize Shrink Width
ctrl + shift + l
	i3-msg resize shrink width 3 px or 3 ppt

# Resize Grow Width (Arrow)
ctrl + shift + Left
	i3-msg resize grow width 3 px or 3 ppt

# Resize Shrink Height (Arrow)
ctrl + shift + Down
	i3-msg resize shrink height 3 px or 3 ppt

# Resize Grow Height (Arrow)
ctrl + shift + Up
	i3-msg resize grow height 3 px or 3 ppt

# Resize Shrink Width (Arrow)
ctrl + shift + Right
	i3-msg resize shrink width 3 px or 3 ppt

# === LAYOUTS ===

# Layout Tabbed
#super + w
#	i3-msg layout tabbed

# Cycle Layout (split → tabbed → stacking)
#super + t
#	i3-msg layout toggle split tabbed stacking

# Cycle through tabs / siblings in current container
alt + Tab
	i3-msg focus next

alt + shift + Tab
	i3-msg focus prev

# === WM CONTROL ===

# Reload sxhkd Config
alt + Escape
	pkill -USR1 -x sxhkd; notify-send 'sxhkd' 'Reloaded config'

# Reload i3 Config
alt + shift + r
	i3-msg reload; notify-send 'i3' 'Reloaded'

# Exit i3
#alt + shift + e
	i3-nagbar -t warning -m "End your X session?"" -B "Yes, exit i3"; i3-msg exit
  #i3-msg exit

# Close Window
alt + q
	i3-msg kill

alt + shift + q
  i3-msg kill

