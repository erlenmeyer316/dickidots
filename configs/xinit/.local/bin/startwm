#!/usr/bin/env bash
# kp — keepassxc-cli wrapper
# Deps: keepassxc-cli, libsecret-tools, fzf, xclip/xsel

set -euo pipefail

prefix="XINIT_"
wm=$1
  
while IFS= read -r name <&3; do
  if [ "${wm}" == "${!name}" ]; then
    echo "Launching ${wm}..."
    . "${HOME}/xinitrc.d/99-wm-${!name}.sh"
  fi
done 3< <(compgen -e "$prefix")


